{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kauevestena/oswm_codebase/main/metadata/schemas/oswm-metadata.schema.json",
  "title": "OpenSidewalkMap Metadata Profile",
  "description": "JSON application profile for catalogues, collections, and resources published by OSWM nodes.",
  "type": "object",
  "required": [
    "$schema",
    "metadata_profile",
    "identifier",
    "resource_type",
    "title",
    "abstract",
    "language",
    "responsible_parties",
    "spatial",
    "temporal",
    "lineage",
    "quality",
    "rights",
    "links",
    "metadata_generation"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "metadata_profile": {
      "$ref": "#/$defs/metadataProfile"
    },
    "identifier": {
      "type": "string",
      "format": "uri"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "catalog",
        "collection",
        "dataset",
        "tileset",
        "dataset-description",
        "image",
        "document",
        "report",
        "model-configuration",
        "cache"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "abstract": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "responsible_parties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/responsibleParty"
      }
    },
    "spatial": {
      "oneOf": [
        {
          "$ref": "#/$defs/spatialExtent"
        },
        {
          "type": "null"
        }
      ]
    },
    "temporal": {
      "type": "object",
      "required": [
        "updated",
        "node_registry"
      ],
      "properties": {
        "updated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "node_registry": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "lineage": {
      "type": "object",
      "required": [
        "process_description",
        "sources"
      ],
      "properties": {
        "process_description": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": [
        "scope",
        "standard",
        "statement"
      ],
      "additionalProperties": true
    },
    "rights": {
      "type": "object",
      "additionalProperties": true
    },
    "distribution": {
      "$ref": "#/$defs/distribution"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "path",
          "href"
        ],
        "additionalProperties": true
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "metadata_generation": {
      "$ref": "#/$defs/generation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "resource_type": {
            "not": {
              "enum": [
                "catalog",
                "collection"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "distribution"
        ]
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "metadataProfile": {
      "type": "object",
      "required": [
        "name",
        "version",
        "encoding",
        "alignment",
        "domain",
        "aligned_with",
        "conformance_note"
      ],
      "properties": {
        "name": {
          "const": "OSWM Metadata Profile"
        },
        "version": {
          "type": "string"
        },
        "encoding": {
          "const": "application/json"
        },
        "alignment": {
          "const": "conceptual"
        },
        "domain": {
          "type": "string",
          "enum": [
            "geographic",
            "non-geographic",
            "mixed"
          ]
        },
        "aligned_with": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "role",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        },
        "conformance_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "responsibleParty": {
      "type": "object",
      "required": [
        "name",
        "role",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "spatialExtent": {
      "type": "object",
      "required": [
        "scope",
        "bbox",
        "bbox_order",
        "reference_system"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "bbox_order": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "const": "west"
            },
            {
              "const": "south"
            },
            {
              "const": "east"
            },
            {
              "const": "north"
            }
          ],
          "items": false
        },
        "reference_system": {
          "type": "string",
          "format": "uri"
        },
        "geometry": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "checksum": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": [
        "resource_path",
        "access_url",
        "download_url",
        "media_type",
        "format",
        "byte_size"
      ],
      "properties": {
        "resource_path": {
          "type": "string",
          "pattern": "^data/"
        },
        "access_url": {
          "type": "string",
          "format": "uri"
        },
        "download_url": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        }
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": [
        "title",
        "resource",
        "metadata",
        "media_type",
        "format",
        "byte_size"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "resource": {
          "type": "string",
          "format": "uri"
        },
        "metadata": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        }
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": [
        "rel",
        "href",
        "type"
      ],
      "properties": {
        "rel": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "generation": {
      "type": "object",
      "required": [
        "generator",
        "profile_version",
        "generated_at",
        "code",
        "source_root",
        "deterministic"
      ],
      "properties": {
        "generator": {
          "const": "oswm_codebase.metadata.metadata_generation"
        },
        "profile_version": {
          "type": "string"
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "code": {
          "type": "object"
        },
        "source_root": {
          "const": "data"
        },
        "deterministic": {
          "const": true
        }
      },
      "additionalProperties": true
    }
  }
}
